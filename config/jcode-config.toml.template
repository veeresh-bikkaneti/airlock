# jcode provider profile for the local Ollama endpoint.
# Apply with (verified against jcode v0.65.0 -- --no-api-key/--auth flags from an
# older jcode version don't exist anymore; --provider ollama covers auth automatically):
#   jcode provider add local-ollama --base-url "http://127.0.0.1:12345/v1" \
#     --model "qwen2.5-coder:7b" --provider ollama \
#     --set-default --model-catalog --overwrite
# (writes this block into %USERPROFILE%\.jcode\config.toml — jcode has no per-project config)
#
# --set-default   : jcode launches straight into this profile, no cloud-provider/API-key prompts
# --model-catalog : model list is fetched live from /v1/models, so newly pulled Ollama models
#                   show up in `jcode model list` without editing this file again

[providers.local-ollama]
type = "openai-compatible"
base_url = "http://127.0.0.1:12345/v1"
auth = "none"
default_model = "qwen2.5-coder:7b"
requires_api_key = false
model_catalog = true

[[providers.local-ollama.models]]
id = "qwen2.5-coder:7b"
